include /mixins/icon.pug
include /mixins/button-hamburger.pug

header
  +hamburger({expanded: false})
  aside#top-menu(aria-hidden='true')
    div.top-menu-header
    nav
      ul
        each item in menu
          li
            a(href=item.link)= item.text
  ul.header-buttons
    li
      a.icon-btn(href="#" aria-label="Arrow")
      +icon('arrow')
    li
      a.icon-btn(href="#" aria-label="Circle")
      +icon('circle')
    li
      a.icon-btn(href="#" aria-label="Square")
      +icon('square')
