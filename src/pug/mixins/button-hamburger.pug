mixin hamburger({ controls = 'primary-navigation', expanded = false, label = 'Open menu' } = {})
  button.hamburger(
    type="button"
    aria-controls=controls
    aria-expanded=String(expanded)
    aria-label=label
    )
    svg.hamburger-icon(
      fill="var(--hamburger-foreground)"
      viewBox="0 0 24 21"
      width="24"
      height="21"
      aria-hidden="true"
      focusable="false"
    )
      rect.line.line__top(width="24" height="5" x="0" y="0" rx="3")
      rect.line.line__middle(width="24" height="5" x="0" y="8" rx="3")
      rect.line.line__bottom(width="24" height="5" x="0" y="16" rx="3")
